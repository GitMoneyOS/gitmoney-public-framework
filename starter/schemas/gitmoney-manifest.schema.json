{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitMoneyManifest",
  "description": "Schema for validating root gitmoney.yaml configuration manifest",
  "type": "object",
  "required": [
    "spec_version",
    "installed_spec_version",
    "owner",
    "profile",
    "source_memory",
    "operator_version",
    "schema_version",
    "required_artifacts"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "installed_spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "enum": ["public-framework", "ai-office", "custom"]
    },
    "source_memory": {
      "type": "string"
    },
    "operator_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
