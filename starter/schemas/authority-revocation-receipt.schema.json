{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorityRevocationReceipt",
  "description": "Forensic record of an authority trigger, fail-closed state transition, and action denial.",
  "type": "object",
  "required": ["schema_version", "receipt_id", "grant_id", "grant_version", "principal_id", "run_id", "trigger_policy_id", "trigger_type", "triggered_at", "invariant_refs", "evidence_refs", "prior_status", "transition_path", "resulting_status", "prior_epoch", "resulting_epoch", "blocked_action_ids", "in_flight_action_ids", "human_review_status", "automatic_restoration", "authority_source_hash", "receipt_digest"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "receipt_id": {"type": "string", "pattern": "^ARR-[A-Z0-9-]{1,48}$"},
    "grant_id": {"type": "string", "pattern": "^AGR-[A-Z0-9-]{1,48}$"},
    "grant_version": {"type": "integer", "minimum": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "trigger_policy_id": {"type": "string", "minLength": 1},
    "trigger_type": {"type": "string", "enum": ["HARD_INVARIANT_VIOLATION", "UNAUTHORIZED_ACTION_ATTEMPT", "VERIFICATION_FAILURE", "ANOMALY_THRESHOLD", "RISK_THRESHOLD"]},
    "triggered_at": {"type": "string", "format": "date-time"},
    "invariant_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "prior_status": {"type": "string", "enum": ["ACTIVE", "HOLD", "DOWNGRADED"]},
    "transition_path": {"type": "array", "items": {"type": "string", "enum": ["ACTIVE", "ANOMALY_DETECTED", "HOLD", "DOWNGRADED", "FROZEN"]}, "minItems": 3},
    "resulting_status": {"type": "string", "enum": ["HOLD", "FROZEN", "REVOKED"]},
    "prior_epoch": {"type": "integer", "minimum": 0},
    "resulting_epoch": {"type": "integer", "minimum": 1},
    "blocked_action_ids": {"type": "array", "items": {"type": "string"}},
    "in_flight_action_ids": {"type": "array", "items": {"type": "string"}},
    "human_review_status": {"type": "string", "enum": ["PENDING", "IN_PROGRESS", "DECIDED"]},
    "human_reviewer": {"type": "string"},
    "human_decision_reference": {"type": "string"},
    "automatic_restoration": {"type": "boolean", "enum": [false]},
    "authority_source_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "receipt_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  },
  "additionalProperties": false,
  "x-gitmoney-schema-version": "0.1.0"
}
