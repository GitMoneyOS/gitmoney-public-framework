{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorityActionRequest",
  "description": "A consequential action request evaluated against the current grant and runtime authority epoch.",
  "type": "object",
  "required": ["action_id", "grant_id", "grant_version", "principal_id", "authority_epoch", "operation", "action", "resource", "environment", "data_classification", "consequence", "requested_spend_amount", "spend_currency", "requested_at"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "grant_id": {"type": "string", "pattern": "^AGR-[A-Z0-9-]{1,48}$"},
    "grant_version": {"type": "integer", "minimum": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "operation": {"type": "string", "enum": ["READ", "WRITE", "EXTERNAL_COMMITMENT"]},
    "action": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["LOCAL", "TEST", "STAGING", "PRODUCTION"]},
    "data_classification": {"type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "consequence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "requested_spend_amount": {"type": "number", "minimum": 0},
    "spend_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "human_approval_reference": {"type": "string"}
  },
  "additionalProperties": false,
  "x-gitmoney-schema-version": "0.1.0"
}
