{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OwnerDecisionRecord",
  "description": "Schema for validating executive rulings and architecture decision records",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "date",
    "authority",
    "status",
    "context",
    "ruling",
    "consequences"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "context": {
      "type": "string"
    },
    "ruling": {
      "type": "string"
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}